rules_version = '2';
// Reglas de Firestore del álbum. Copiar en: Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.token.email == 'javier@fotos-javi.com';
    }

    // Fotos: todos las ven; solo se suben con cuenta y con TU propio nombre;
    // cada uno borra las suyas y el administrador, cualquiera.
    match /fotos/{fotoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userName ==
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombre;
      allow update: if false;
      allow delete: if esAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Ficha de cada usuario (nombre, correo y copia de la contraseña).
    // Solo la ve su dueño y el administrador. El nombre no se puede cambiar.
    match /usuarios/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && getAfter(/databases/$(database)/documents/nombres/$(request.resource.data.nombreClave)).data.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.nombre == resource.data.nombre
        && request.resource.data.nombreClave == resource.data.nombreClave;
      allow delete: if esAdmin();
    }

    // Nombres ya usados (para que no haya dos personas con el mismo nombre)
    match /nombres/{nombre} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if esAdmin();
    }
  }
}
